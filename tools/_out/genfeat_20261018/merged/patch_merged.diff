@@ -0,0 +1,149 @@
+# 45 deg elbows with a helical thread / female port / swivel nut on the 135 deg leg (ANGLED, 2026-10-18: 1503 1504 5501 5503 5505 6902): OCP rebuild
+# of every configuration from the generator's OWN data (gen_tee.build_rows), in the macro's feature order - LEG1 (+X) / LEG2 (135 deg) revolves,
+# hex arms HEX1 / HEX2 (flats normal to Z), the 30deg double-cone corner PUCK about Z (equator PUCK_INSET inside the hex corners, as the macro),
+# NECKTRIM / NECKFILL on a +X swivel that carries the turn, the swivel nut hex cuts (outside the nut hexagon over the nut hex length, on either
+# leg), the adjustable-ORB locknut cut (+X), then each leg's pocket / connecting bore / bore from its face. Threads are not modelled (every THD_
+# feature is suppressed in the saved masters), so the volumes are the ones sweep_configs reports on a saved master.
+#
+#   python tools/measure/angled_model.py --all <root>               -> every configuration: one solid?, volume (expected values for the dry run)
+#   python tools/measure/angled_model.py --loop <root> [<pn> ...]   -> CLOSED LOOP: model STEP -> the validated extractors (forged.py for the pipe
+#                                                                     legs, neck45.py for the swivel legs, forged.corner_arcs for the puck) ->
+#                                                                     must give back the generator's own values (tips, hex faces, collar, drill,
+#                                                                     bores, A/F, body face, neck, nut face, nothing outside the neck)
+#   python tools/measure/angled_model.py --cmp <root> <pn>          -> vs the Brennan STEP of <pn> (placed like it): both readings + the
+#                                                                     symmetric difference in connected pieces
+# Output folder: $TEE_MODEL_OUT or tools/_out/scratch.
+import os as _os, sys as _sys
+_HERE = _os.path.dirname(_os.path.abspath(__file__)); _TOOLS = _os.path.dirname(_HERE)
+for _p in (_os.path.join(_TOOLS, 'generators'), _TOOLS, _HERE):
+    if _p not in _sys.path: _sys.path.insert(0, _p)
+import omi_paths as OP
+import sys, os, math, json
+os.environ.setdefault('GT_OUT', OP.SCRATCH)
+from OCP.gp import gp_Pnt, gp_Ax1, gp_Dir
+from OCP.BRepPrimAPI import BRepPrimAPI_MakeRevol
+from nwo_model import face, vol, fuse, cut, write, MM
+from tee_model import revolve_leg, hex_prism, cyl, nsolids, place, pieces
+
+OUTD = os.environ.get('TEE_MODEL_OUT', OP.SCRATCH)
+U135 = (math.cos(math.radians(135)), math.sin(math.radians(135)))
+AXES = [(1.0, 0.0), U135]
+THETA = [0.0, 135.0]
+SIDE = [-1, 1]                          # LP half-plane of each model leg: away from the other leg (as tee_model MODEL_LEGS)
+BRENNAN = {'5501-08-08-FG': (('mirror_x',), [('NPTFM', 180, -1), ('NPTFM', 45, 1)], [0, 1]),
+           '5503-16-16-FG': (('rot_z', 45.0), [('NPTFM', 180, -1), ('NPTFF', 45, 1)], [1, 0])}
+
+
+def ring(u, a0, a1, r0, r1):
+    ux, uy = u; nx, ny = -uy, ux
+    pts = [(a * ux + r * nx, a * uy + r * ny, 0) for a, r in ((a0, r0), (a1, r0), (a1, r1), (a0, r1))]
+    return BRepPrimAPI_MakeRevol(face(pts), gp_Ax1(gp_Pnt(0, 0, 0), gp_Dir(ux, uy, 0)), 2 * math.pi).Shape()
+
+
+def outside_hex(u, af, a0, a1):
+    """everything outside the hexagon (A/F af, flats normal to Z) between a0 and a1 along u: the 'outside' nut-hex cut"""
+    return cut(hex_prism(u, 60.0, a0, a1), hex_prism(u, af, a0, a1))
+
+
+def build(sp, b, turn=True):
+    import gen_tee as T
+    legs = b['legs']; BR = b['BR']; AC = b['AC']; AF = b['AF']
+    S = fuse(revolve_leg(legs[0]['V'], AXES[0]), revolve_leg(legs[1]['V'], AXES[1]))
+    for lg, u in zip(legs, AXES): S = fuse(S, hex_prism(u, AF, 0.0, lg['hexl']))
+    h = BR; xc = AC - T.PUCK_INSET; r1 = xc - BR * math.tan(math.radians(30))
+    S = fuse(S, BRepPrimAPI_MakeRevol(face([(0, 0, -h), (r1, 0, -h), (xc, 0, 0), (r1, 0, h), (0, 0, h)]), gp_Ax1(gp_Pnt(0, 0, 0), gp_Dir(0, 0, 1)), 2 * math.pi).Shape())
+    for lg, u in zip(legs, AXES):
+        t = lg.get('trim')
+        if turn and t:
+            assert u == AXES[0], 'neck turn on the +X leg only (as the macro)'
+            S = cut(S, ring(u, t['a0'], t['a0'] + t['len'], t['rin'], t['rout']))
+            S = fuse(S, ring(u, t['a0'], t['a0'] + t['len'], t['rin'], t['r']))
+    for lg, u in zip(legs, AXES):
+        if lg['kind'] in ('JICSW', 'NPSMSW'): S = cut(S, outside_hex(u, lg['nut_af'], lg['Mtip'] - lg['m']['HEXL'], lg['Mtip']))
+    for lg, u in zip(legs, AXES):
+        if lg['kind'] == 'NWO':
+            assert u == AXES[0] and not lg.get('nwo_trim'), 'adjustable ORB leg on +X without ORBTRIM only'
+            S = cut(S, outside_hex(u, lg['nut']['af'], lg['nut']['n0'], lg['nut']['w0']))
+    for lg, u in zip(legs, AXES):
+        M = lg.get('Mtip', lg['V'][-1][0])
+        if lg['kind'] == 'NPTFF':
+            S = cut(S, cyl(u, lg['td'] / 2, M - lg['pocket'], M))
+            if not lg['to_centre']: S = cut(S, cyl(u, lg['conn'] / 2, 0.0, M))
+        else:
+            S = cut(S, cyl(u, lg['bore'] / 2, 0.0, M))
+    return S
+
+
+def expect(b, i, lg):
+    """the generator's own values for leg i (what the extractor must give back)"""
+    M = lg.get('Mtip', lg['V'][-1][0])
+    if lg['kind'] == 'NPTFM':
+        return dict(tip=M, hex_face=lg['hexl'], relief_dia=2 * lg['V'][3][1], bore_dia=lg['bore'], taper_len=lg['V'][4][0] and (M - lg['V'][4][0]))
+    if lg['kind'] == 'NPTFF':
+        return dict(face=M, collar_r=b['BR'], collar_len=lg['collar'], drill_dia=lg['td'],
+                    drill_to_from_face=lg['pocket'] if lg['to_centre'] else lg['pocket'])
+    return dict(nut_face=M, face=lg['hexl'], neckr=lg['m']['NECKR'], excess=0.0)
+
+
+def read(p, i, lg):
+    import forged as F, neck45 as N
+    if lg['kind'] == 'NPTFM':
+        r = F.nptfm(p, THETA[i], SIDE[i])
+        return r, dict(tip=r['tip'], hex_face=r['hex_face'], relief_dia=r['relief_dia'], bore_dia=r['bore_dia'], taper_len=r['taper_len'])
+    if lg['kind'] == 'NPTFF':
+        r = F.nptff(p, THETA[i], SIDE[i])
+        return r, dict(face=r['face'], collar_r=r['collar_r'], collar_len=r['collar_len'], drill_dia=(r['drill'] or {}).get('dia'),
+                       drill_to_from_face=(r['drill'] or {}).get('to_from_face'))
+    r = N.measure(p, THETA[i])
+    return r, dict(nut_face=r['nut_face'], face=r['face'], neckr=r['neckr'], excess=r['excess'])
+
+
+def loop(root, pns):
+    import gen_tee as T, forged as F
+    sp = T.SPEC[root]; built, _ = T.build_rows(root); out = []; bad = 0
+    for b in built:
+        if b['chk'] or (pns and b['pn'] not in pns): continue
+        S = build(sp, b); p = os.path.join(OUTD, f'MODEL_{b["pn"]}.stp'); write(S, p)
+        row = dict(pn=b['pn'], solids=nsolids(S), volume_in3=round(vol(S), 5), legs=[])
+        for i, lg in enumerate(b['legs']):
+            e = expect(b, i, lg)
+            try: raw, g = read(p, i, lg)
+            except Exception as ex: g = {k: f'ERROR {ex}' for k in e}
+            d = {k: (round(e[k], 4), g.get(k), isinstance(g.get(k), (int, float)) and abs(g[k] - e[k]) < 6e-4) for k in e}
+            row['legs'].append(dict(leg=i + 1, kind=lg['kind'], axis=('+X' if i == 0 else '135 deg'), values=d))
+        arcs = F.corner_arcs(p); xc = round(b['AC'] - T.PUCK_INSET, 4)
+        row['puck_arc'] = (xc, arcs, any(abs(a - xc) < 6e-4 for a in arcs))
+        row['ok'] = row['solids'] == 1 and all(v[2] for L in row['legs'] for v in L['values'].values()) and row['puck_arc'][2]
+        bad += not row['ok']; out.append(row); print(json.dumps(row))
+    print(f'{root}: closed loop on {len(out)} configurations, problems {bad}')
+    return out
+
+
+if __name__ == '__main__':
+    import gen_tee as T
+    a = sys.argv[1:]
+    os.makedirs(OUTD, exist_ok=True)
+    if a[0] == '--all':
+        root = a[1]; built, _ = T.build_rows(root); sp = T.SPEC[root]
+        for b in built:
+            if b['chk']: continue
+            S = build(sp, b)
+            print(json.dumps(dict(pn=b['pn'], solids=nsolids(S), volume_in3=round(vol(S), 5))))
+    elif a[0] == '--loop':
+        loop(a[1], a[2:])
+    elif a[0] == '--cmp':
+        import forged as F
+        root, pn = a[1], a[2]; built, _ = T.build_rows(root); sp = T.SPEC[root]
+        b = [x for x in built if x['pn'] == pn and not x['chk']][0]
+        how, blegs, m2b = BRENNAN[pn]
+        S = build(sp, b); pm = os.path.join(OUTD, f'MODEL_{pn}.stp'); write(S, pm)
+        bp = os.path.join(os.environ.get('BRENNAN_STEP_DIR', OP.STEP_DIR), f'BRENNAN_{pn}.stp')
+        B = F.shape(bp); Sb = place(S, how)
+        res = dict(pn=pn, placed=how, model_volume=round(vol(S), 5), model_solids=nsolids(S),
+                   model_legs=[read(pm, i, lg)[1] for i, lg in enumerate(b['legs'])],
+                   brennan_legs=[F.KIND[k](bp, th, sd) for k, th, sd in (blegs[j] for j in m2b)], brennan_volume=round(vol(B), 5),
+                   brennan_corner_arcs=F.corner_arcs(bp), model_corner_arcs=F.corner_arcs(pm))
+        res['brennan_minus_model'] = round(vol(cut(B, Sb)), 5); res['model_minus_brennan'] = round(vol(cut(Sb, B)), 5)
+        res['pieces_brennan_only'] = pieces(cut(B, Sb))[:12]; res['pieces_model_only'] = pieces(cut(Sb, B))[:12]
+        json.dump(res, open(os.path.join(OUTD, f'cmp_{pn}.json'), 'w'), indent=1)
+        print('written', os.path.join(OUTD, f'cmp_{pn}.json'))
diff -ruN a/tools/measure/flange62.py b/tools/measure/flange62.py
--- a/tools/measure/flange62.py	1969-12-31 18:00:00.000000000 -0600
+++ b/tools/measure/flange62.py	2026-10-18 15:38:50.964073400 -0500
@@ -0,0 +1,219 @@
+# SAE code 61 / code 62 FLANGE parts (2026-10-02, new masters 1800 / 1824): plane sections through the part axis of a Brennan STEP,
+# read as an outline in (a, r) = (distance from the end opposite the flange face, distance from the axis).
+#
+#   python tools/measure/flange62.py straight <step> [...]   JIC x flange straight (1700 / 1800): JIC end length, round collar dia,
+#                                                           two wrench flats (A/F, zone length from the collar face), 30deg collar
+#                                                           chamfer, collar face to neck start (= gen_straight2 COLLARL), neck
+#                                                           dia / length, flange head (OD, thickness, face O-ring groove), through
+#                                                           bore, overall length
+#   python tools/measure/flange62.py plug <step> [...]      flange plug (1724 / 1824): head + round stub, overall length, edge chamfers
+#   python tools/measure/flange62.py head <step> [...]      the flange head only (any part whose axis is the bbox's odd axis)
+#
+# How: tools/measure/prof.leg_edges cuts the plane through the axis (normal to each of the two cross axes) and returns the edges
+# with r >= 0; the OUTER silhouette r(a) is the largest radius of any non-vertical edge over a (sampled between edge ends, so
+# every corner is an exact edge end point). The plane in which the collar reads SMALLER is the plane normal to the wrench flats.
+# Validation (NOTES.md, evidence/measure/): on the Brennan 1700-08/-12/-16/-20/-24/-32 STEPs the head returns FLG61_MEAS
+# (gen_straight2) and tools/measure/flange.py exactly, and overall length / wrench flats return BRENNAN_1700 (gen_straight2)
+# and the Brennan Flange catalog p.3 1700 table (L, A/F).
+import os as _os, sys as _sys
+_HERE = _os.path.dirname(_os.path.abspath(__file__)); _TOOLS = _os.path.dirname(_HERE)
+for _p in (_os.path.join(_TOOLS, 'generators'), _TOOLS, _HERE):
+    if _p not in _sys.path: _sys.path.insert(0, _p)
+import sys, json, math
+from prof import leg_edges, bbox
+
+TOL = 2e-4      # same-coordinate tolerance (the STEPs are exact to 1e-4 in)
+
+
+def axis_of(p):
+    b = bbox(p); spans = [b[3] - b[0], b[4] - b[1], b[5] - b[2]]
+    return max(range(3), key=lambda k: abs(spans[k] - sum(spans[j] for j in range(3) if j != k) / 2)), b
+
+
+def segs(p, axis, sign, pn):
+    out = []
+    for kind, P in leg_edges(p, axis, sign, pn, a0=-99):
+        if min(r for a, r in P) < -1e-6: continue
+        pts = sorted(P)
+        out.append(dict(P=pts, a1=pts[0][0], a2=pts[-1][0], line=(kind == 'L')))
+    return out
+
+
+def r_at(S, a):
+    """outer silhouette radius at a (largest radius of any non-vertical edge spanning a)"""
+    best = None
+    for s in S:
+        if s['a2'] - s['a1'] < 1e-6 or not (s['a1'] - 1e-9 <= a <= s['a2'] + 1e-9): continue
+        P = s['P']
+        for (x1, r1), (x2, r2) in zip(P, P[1:]):
+            if x2 - x1 < 1e-12 or not (x1 - 1e-9 <= a <= x2 + 1e-9): continue
+            r = r1 + (r2 - r1) * (a - x1) / (x2 - x1)
+            best = r if best is None else max(best, r)
+    return best
+
+
+def silhouette(S, a0, a1):
+    """outer outline between a0 and a1 as intervals (lo, hi, r_lo, r_hi), merged where collinear"""
+    xs = sorted({round(x, 6) for s in S for (x, r) in s['P'] if a0 - 1e-9 <= x <= a1 + 1e-9} | {a0, a1})
+    iv = []
+    for lo, hi in zip(xs, xs[1:]):
+        if hi - lo < 1e-6: continue
+        e = 1e-6
+        rl, rh = r_at(S, lo + e), r_at(S, hi - e)
+        if rl is None or rh is None: continue
+        sl = (rh - rl) / (hi - lo - 2 * e)
+        rl, rh = rl - sl * e, rh + sl * e
+        if iv:
+            plo, phi, prl, prh = iv[-1]
+            psl = (prh - prl) / (phi - plo)
+            if abs(phi - lo) < 1e-6 and abs(prh - rl) < TOL and abs(psl - sl) < 1e-3:
+                iv[-1] = (plo, hi, prl, rh); continue
+        iv.append((lo, hi, rl, rh))
+    return iv
+
+
+def ang(iv):
+    lo, hi, rl, rh = iv; return math.degrees(math.atan2(abs(rh - rl), hi - lo))
+
+
+def head(S, af):
+    """flange head at the face af: O-ring groove (vertical bottom line between two horizontals that reach the face), head OD and
+    thickness from the silhouette (edge chamfers at the face rim / back are allowed and reported)"""
+    vert = [s for s in S if s['line'] and abs(s['a2'] - s['a1']) < TOL]
+    hor = [s for s in S if s['line'] and abs(s['P'][0][1] - s['P'][-1][1]) < TOL and s['a2'] - s['a1'] > 0.01]
+    g = None
+    for v in vert:
+        av = v['a1']
+        if abs(av - af) < TOL or av < af - 0.3: continue
+        lo, hi = sorted((v['P'][0][1], v['P'][-1][1]))
+        hl = [h for h in hor if abs(h['a1'] - av) < TOL and abs(h['a2'] - af) < TOL and abs(h['P'][0][1] - lo) < TOL]
+        hh = [h for h in hor if abs(h['a1'] - av) < TOL and abs(h['a2'] - af) < TOL and abs(h['P'][0][1] - hi) < TOL]
+        if hl and hh: g = dict(GI=lo, GO=hi, GD=af - av); break
+    if g is None: return None
+    sil = silhouette(S, af - 1.5, af)
+    rO = max(max(i[2], i[3]) for i in sil)
+    run = [i for i in sil if max(i[2], i[3]) > rO - 0.03]          # the head (with any edge chamfer) is the last run near rO
+    k = len(sil) - 1
+    while k >= 0 and max(sil[k][2], sil[k][3]) > rO - 0.03: k -= 1
+    a_back = sil[k + 1][0]
+    flat = [i for i in sil[k + 1:] if abs(i[2] - rO) < TOL and abs(i[3] - rO) < TOL]
+    ch_face = af - flat[-1][1] if flat else None
+    ch_back = flat[0][0] - a_back if flat else None
+    return dict(face=round(af, 4), O=round(2 * rO, 4), TH=round(af - a_back, 4), GI=round(g['GI'], 4), GO=round(g['GO'], 4), GD=round(g['GD'], 4),
+                head_chamfer_face=round(ch_face, 4), head_chamfer_back=round(ch_back, 4), back=round(a_back, 4))
+
+
+def bore(S, a0, af):
+    """smallest-radius long horizontal line (the through bore) and a chamfer at the flange face"""
+    hor = [s for s in S if s['line'] and abs(s['P'][0][1] - s['P'][-1][1]) < TOL and s['a2'] - s['a1'] > 0.5 * (af - a0)]
+    if not hor: return None
+    b = min(hor, key=lambda s: s['P'][0][1]); rb = b['P'][0][1]
+    ch = [s for s in S if s['line'] and abs(s['a2'] - af) < TOL and abs(s['a1'] - b['a2']) < TOL and s['a2'] - s['a1'] > 1e-4]
+    out = dict(D=round(2 * rb, 4), from_a=round(b['a1'], 4), to_a=round(b['a2'], 4))
+    if ch:
+        c = ch[0]; r2 = max(c['P'][0][1], c['P'][-1][1])
+        out.update(face_chamfer_len=round(c['a2'] - c['a1'], 4), face_chamfer_dia=round(2 * r2, 4),
+                   face_chamfer_ang=round(math.degrees(math.atan2(r2 - rb, c['a2'] - c['a1'])), 1))
+    return out
+
+
+def measure_straight(p):
+    ax, b = axis_of(p)
+    pns = [k for k in (0, 1, 2) if k != ax]
+    best = None
+    for sign in (1, -1):
+        S0 = segs(p, ax, sign, pns[-1])
+        a_lo = min(s['a1'] for s in S0); a_hi = max(s['a2'] for s in S0)
+        h = head(S0, a_hi)
+        if h: best = (sign, a_lo, a_hi, h); break
+    assert best, 'no flange head found at either end'
+    sign, a0, af, H = best
+    out = dict(step=_os.path.basename(p), axis='XYZ'[ax], sign=sign, L=round(af - a0, 4), head=H)
+    planes = {}
+    for pn in pns:
+        S = segs(p, ax, sign, pn)
+        sil = silhouette(S, a0, af)
+        planes[pn] = (S, sil)
+    # JIC end: from the tip to the collar face = the LAST big step up (> 0.05) before the head back in the ROUND plane (the plane whose outline
+    # reaches the larger radius before the head = the collar; the flats plane may step up again at the neck start).
+    # 2026-10-18 (genfeat flange): was the FIRST step up in one plane - on a model JIC end of -12 and up the land -> thread major step is a
+    # vertical step of (TM - CD)/2 > 0.05 (Brennan draws a 45deg chamfer there), so the first step was the thread start, not the collar face;
+    # and where the flats equal the thread major (1700-20-16) the flats plane shows no step at the collar face at all. Re-validated on the 9
+    # Brennan 1700 STEPs and the 1800-08-08 pilot (identical readings: genfeat_20261018/flange/test/ocp/flange62_revalidation.txt).
+    def _rmax(pn_):
+        return max(max(i[2], i[3]) for i in planes[pn_][1] if i[1] <= H['back'] + 5e-4)
+    sil = planes[max(pns, key=_rmax)][1]
+    a_col = None
+    for i0, i1 in zip(sil, sil[1:]):
+        if i1[2] - i0[3] > 0.05 and i1[0] < H['back'] - 5e-4: a_col = i1[0]
+    out['jic_end_len'] = round(a_col - a0, 4)
+    # in each plane the outline between the collar face and the head back
+    res = {}
+    for pn, (S, sil) in planes.items():
+        mid = [i for i in sil if i[0] >= a_col - 1e-6 and i[1] <= H['back'] + 5e-4]
+        res[pn] = mid
+    # the plane with the smaller first radius after the collar face carries the flats
+    first = {pn: res[pn][0][2] for pn in pns}
+    pf = min(pns, key=lambda k: first[k]); pr = max(pns, key=lambda k: first[k])
+    rnd, flt = res[pr], res[pf]
+    # round plane: collar (horizontal at RC), chamfer (slanted down), neck (horizontal at RN) up to the head back
+    rc = rnd[0]; assert abs(rc[2] - rc[3]) < TOL, ('collar not cylindrical', rc)
+    out['collar_dia'] = round(2 * rc[2], 4); out['collar_round_len'] = round(rc[1] - rc[0], 4)
+    ch = rnd[1]; out['collar_chamfer_ang'] = round(ang(ch), 1); out['collar_chamfer_len'] = round(ch[1] - ch[0], 4)
+    nk = rnd[2]; assert abs(nk[2] - nk[3]) < TOL, ('neck not cylindrical', nk)
+    out['neck_dia'] = round(2 * nk[2], 4); out['neck_len'] = round(nk[1] - nk[0], 4)
+    out['neck_start_from_tip'] = round(nk[0] - a0, 4)
+    # 2026-10-02 (review FLANGE62, finding 4): the collar length = collar face to the neck start (round collar + 30deg chamfer), read in the
+    # ROUND plane - this is gen_straight2's COLLARL@DRIVE (the flats cut runs to the neck start). It is NOT the flats zone length below:
+    # the two are equal only where the flats are narrower than the neck (1800-08-08: a step face at the neck start); where the flats are
+    # wider than the neck they run out in the chamfer cone before the neck starts (all 9 Brennan 1700 STEPs).
+    out['collar_face_to_neck_start'] = round(nk[0] - rc[0], 4)
+    assert abs(out['collar_face_to_neck_start'] - (out['collar_round_len'] + out['collar_chamfer_len'])) < 2 * TOL, ('collar + chamfer != neck start', out)
+    assert abs(rc[0] - a_col) < TOL, ('round-plane collar face is not the collar face', rc[0], a_col)
+    assert abs(nk[1] - (af - H['TH'])) < 2 * TOL or len(rnd) > 3, ('neck does not reach the head back', nk, af - H['TH'])
+    # flats plane: horizontal at A/F/2 from the collar face; the flats zone ends where the outline leaves that radius
+    f0 = flt[0]; assert abs(f0[2] - f0[3]) < TOL, ('flat not flat', f0)
+    out['flats_AF'] = round(2 * f0[2], 4); out['flats_zone_len'] = round(f0[1] - f0[0], 4)
+    out['flats_end_vs_neck_start'] = round(f0[1] - nk[0], 4)
+    out['flats_end'] = ('step face at the neck start (flats narrower than the neck)' if abs(f0[1] - nk[0]) < TOL else
+                        'run-out in the 30deg chamfer before the neck start (flats wider than the neck)' if f0[1] < nk[0] else 'beyond the neck start (?)')
+    out['flats_plane_normal'] = 'XYZ'[[k for k in (0, 1, 2) if k not in (ax, pf)][0]]
+    out['bore'] = bore(planes[pns[-1]][0], a0, af)
+    out['check_sum_L'] = round(out['jic_end_len'] + out['collar_round_len'] + out['collar_chamfer_len'] + out['neck_len'] + H['TH'], 4)
+    return out
+
+
+def measure_plug(p):
+    ax, b = axis_of(p)
+    pns = [k for k in (0, 1, 2) if k != ax]
+    for sign in (1, -1):
+        S = segs(p, ax, sign, pns[-1])
+        a0 = min(s['a1'] for s in S); af = max(s['a2'] for s in S)
+        H = head(S, af)
+        if H: break
+    assert H, 'no flange head found'
+    out = dict(step=_os.path.basename(p), axis='XYZ'[ax], sign=sign, L=round(af - a0, 4), head=H)
+    for pn in pns:
+        sil = silhouette(segs(p, ax, sign, pn), a0, af)
+        st = [i for i in sil if i[1] <= af - H['TH'] + 5e-4]
+        cyl = max(st, key=lambda i: i[1] - i[0])
+        out[f'stub_dia_plane_{"XYZ"[pn]}'] = round(2 * cyl[2], 4)
+        out['stub_len'] = round(af - H['TH'] - a0, 4)
+        out['stub_back_chamfer'] = round(cyl[0] - a0, 4)
+        out['stub_front_end'] = round(cyl[1] - a0, 4)
+    return out
+
+
+def measure_head(p):
+    ax, b = axis_of(p)
+    pns = [k for k in (0, 1, 2) if k != ax]
+    for sign in (1, -1):
+        S = segs(p, ax, sign, pns[-1])
+        H = head(S, max(s['a2'] for s in S))
+        if H: return dict(step=_os.path.basename(p), axis='XYZ'[ax], sign=sign, **H)
+    return None
+
+
+if __name__ == '__main__':
+    mode = sys.argv[1]; fn = dict(straight=measure_straight, plug=measure_plug, head=measure_head)[mode]
+    for p in sys.argv[2:]: print(json.dumps(fn(p)))
diff -ruN a/tools/measure/flange62_model.py b/tools/measure/flange62_model.py
--- a/tools/measure/flange62_model.py	1969-12-31 18:00:00.000000000 -0600
+++ b/tools/measure/flange62_model.py	2026-10-18 15:38:50.966426600 -0500
@@ -0,0 +1,93 @@
+# OCP rebuild of gen_straight2 configurations with a code 62 flange end (2026-10-02, FLANGE62: 1800 / 1824) from the generator's OWN
+# data, in the macro's feature order: DRIVE outline (the emit() vertex chain, checks/allcfg_check.straight_chain) revolved about X; for a
+# 'flats' SPEC the two wrench flats = everything outside |y| <= WAF/2 removed over x = START..START+DEPTH (FLATCUT, flats normal to Y as the
+# macro's Right-Plane rectangle); bores BORE_A / BORE_B (mode 'mid'). Threads are not modelled (masters are saved with THD_* suppressed),
+# so the volumes are the ones sweep_configs reports on a saved master.
+#
+#   python tools/measure/flange62_model.py <root> [<pn> ...]       -> <GS_OUT or scratch>/MODEL_<pn>.stp + one line per configuration
+#   (OMI_ROOT selects the review tables, e.g. the FLANGE62 TEST scratch root)
+import os as _os, sys as _sys
+_HERE = _os.path.dirname(_os.path.abspath(__file__)); _TOOLS = _os.path.dirname(_HERE)
+for _p in (_os.path.join(_TOOLS, 'generators'), _TOOLS, _HERE, _os.path.join(_TOOLS, 'checks')):
+    if _p not in _sys.path: _sys.path.insert(0, _p)
+import omi_paths as OP
+import sys, os, json, math
+os.environ.setdefault('GS_OUT', OP.SCRATCH)
+from OCP.gp import gp_Pnt, gp_Ax1, gp_Ax2, gp_Dir
+from OCP.BRepPrimAPI import BRepPrimAPI_MakeRevol, BRepPrimAPI_MakeBox, BRepPrimAPI_MakeCylinder
+from OCP.TopExp import TopExp_Explorer
+from OCP.TopAbs import TopAbs_SOLID, TopAbs_FACE
+from OCP.TopoDS import TopoDS
+from OCP.BRepAdaptor import BRepAdaptor_Surface
+from OCP.GeomAbs import GeomAbs_Plane
+from OCP.Bnd import Bnd_Box
+from OCP.BRepBndLib import BRepBndLib
+from nwo_model import face, vol, fuse, cut, write, MM
+from allcfg_check import straight_chain
+
+
+def nsolids(S):
+    n = 0; e = TopExp_Explorer(S, TopAbs_SOLID)
+    while e.More(): n += 1; e.Next()
+    return n
+
+
+def flats_faces(S):
+    """2026-10-02 (review FLANGE62 round 2): the same reading of the wrench flats as the macro's FlatsAcross - planar faces parallel to the
+    axis (X) that do not contain it: count, how many are parallel to the first, distance between the outermost two along their normal,
+    axial extent (tight face boxes). Inches."""
+    n = npar = 0; n0 = None; dl, dh = 1e30, -1e30; x0, x1 = 1e30, -1e30
+    e = TopExp_Explorer(S, TopAbs_FACE)
+    while e.More():
+        f = TopoDS.Face(e.Current()); a = BRepAdaptor_Surface(f)
+        if a.GetType() == GeomAbs_Plane:
+            pl = a.Plane(); d_ = pl.Axis().Direction(); o_ = pl.Location()
+            nx, ny, nz = d_.X(), d_.Y(), d_.Z()
+            if abs(nx) < 1e-4:
+                sg = -1.0 if (ny < -1e-4 or (abs(ny) <= 1e-4 and nz < 0)) else 1.0
+                d = sg * (ny * o_.Y() + nz * o_.Z()) / MM
+                if abs(d) > 0.0005 / 0.0254:
+                    n += 1
+                    if n0 is None: n0 = (sg * ny, sg * nz)
+                    if abs(sg * ny * n0[0] + sg * nz * n0[1] - 1) < 1e-4: npar += 1
+                    dl, dh = min(dl, d), max(dh, d)
+                    bb = Bnd_Box(); BRepBndLib.AddOptimal_s(f, bb, False, False)
+                    x0, x1 = min(x0, bb.CornerMin().X() / MM), max(x1, bb.CornerMax().X() / MM)
+        e.Next()
+    return dict(n=n, parallel=npar, across=round(dh - dl, 6) if n else None, x0=round(x0, 6) if n else None, x1=round(x1, 6) if n else None)
+
+
+def build(b, sp):
+    cols, EA, EB, L, hexb, rB, body, chk = b
+    V = straight_chain(EA, EB, L, rB)
+    S = BRepPrimAPI_MakeRevol(face([(x, r, 0) for x, r in V]), gp_Ax1(gp_Pnt(0, 0, 0), gp_Dir(1, 0, 0)), 2 * math.pi).Shape()
+    v_rev = vol(S)
+    v_flats = None
+    if sp.get('flats'):
+        x0, dep, af = cols['START@FLATCUT'], cols['DEPTH@FLATCUT'], cols['WAF@FLATS']; BIG = 10.0
+        v0 = vol(S)
+        for y0, y1 in ((af / 2, BIG), (-BIG, -af / 2)):
+            S = cut(S, BRepPrimAPI_MakeBox(gp_Pnt(x0 * MM, y0 * MM, -BIG * MM), gp_Pnt((x0 + dep) * MM, y1 * MM, BIG * MM)).Shape())
+        v_flats = v0 - vol(S)
+    mode = sp['bore'][0]
+    if mode == 'mid':
+        dA, sA = cols['DA@BORE_A'], cols['DEPTH@BORECUT_A']; dB, sB = cols['DB@BORE_B'], cols['DEPTH@BORECUT_B']
+        S = cut(S, BRepPrimAPI_MakeCylinder(gp_Ax2(gp_Pnt(0, 0, 0), gp_Dir(1, 0, 0)), dA / 2 * MM, sA * MM).Shape())
+        S = cut(S, BRepPrimAPI_MakeCylinder(gp_Ax2(gp_Pnt(L * MM, 0, 0), gp_Dir(-1, 0, 0)), dB / 2 * MM, sB * MM).Shape())
+    elif mode != 'none':
+        raise NotImplementedError(f'bore mode {mode}')
+    return S, dict(v_revolve=round(v_rev, 6), v_flats_removed=round(v_flats, 6) if v_flats is not None else None,
+                   flats_faces=flats_faces(S) if sp.get('flats') else None)
+
+
+if __name__ == '__main__':
+    import gen_straight2 as G
+    root = sys.argv[1]; pns = sys.argv[2:]; sp = G.SPEC[root]
+    built, skipped = G.build_rows(root)
+    od = os.environ['GS_OUT']; os.makedirs(od, exist_ok=True)
+    for b in built:
+        pn = b[0]['$PRP@PartNo']
+        if b[7] or (pns and pn not in pns): continue
+        S, info = build(b, sp)
+        p = os.path.join(od, f'MODEL_{pn}.stp'); write(S, p)
+        print(json.dumps(dict(pn=pn, solids=nsolids(S), volume_in3=round(vol(S), 6), **info, step=p)))
diff -ruN a/tools/measure/flgleg.py b/tools/measure/flgleg.py
--- a/tools/measure/flgleg.py	1969-12-31 18:00:00.000000000 -0600
+++ b/tools/measure/flgleg.py	2026-10-18 15:38:50.968604500 -0500
@@ -0,0 +1,42 @@
+# FLANGE LEG of a forged elbow (2026-10-18, genfeat flange: Q-NEW-FLG61LEG / Q-NEW-FLG62LEG, DESIGN 4.11 "flgleg.py"): plane sections through
+# the leg axis of a STEP, read with the tools/measure/flange62.py outline helpers (flange62.head is the head reader validated on the 9 Brennan
+# 1700 STEPs = FLG61_MEAS and on the 1800-08-08 / 1824-08 / 1804-08-08-FG code 62 heads = FLG62_MEAS[8]).
+#
+#   python tools/measure/flgleg.py <step> <axis 0|1|2> <sign +1|-1> [...]   one JSON line per STEP: the leg whose axis is <sign> x <axis>
+#
+# Returns, in leg coordinates (a = distance from the axis crossing, origin of the STEP): M = the flange face, the head (O, TH, GI, GO, GD and the
+# head back face), the bore D of the leg (smallest long horizontal line from the face), and the outline radius 0.01 behind the head back face in
+# the plane where the hex shows its FLATS (radial coordinate = Z: flats normal to Z, as gen_tee and the Brennan forgings) and in the plane where it
+# shows its CORNERS: = the hex flats / corner radius when the forged hex arm runs up to the head (the model), = a neck radius on the Brennan parts.
+import os as _os, sys as _sys
+_HERE = _os.path.dirname(_os.path.abspath(__file__)); _TOOLS = _os.path.dirname(_HERE)
+for _p in (_os.path.join(_TOOLS, 'generators'), _TOOLS, _HERE):
+    if _p not in _sys.path: _sys.path.insert(0, _p)
+import sys, json
+from flange62 import segs, head, bore, r_at
+
+
+def measure_leg(p, axis, sign):
+    inplane = [k for k in (0, 1) if k != axis]
+    assert axis in (0, 1) and inplane, 'the flange leg must lie in the XY plane (flats normal to Z)'
+    pn_flats = inplane[0]        # section plane normal to the other in-plane axis: radial coordinate = Z -> the hex flats
+    pn_corners = 2               # section plane z = 0: radial coordinate = the other in-plane axis -> the hex corners
+    out = dict(step=_os.path.basename(p), axis='XYZ'[axis], sign=sign)
+    for tag, pn in (('flats', pn_flats), ('corners', pn_corners)):
+        S = [s for s in segs(p, axis, sign, pn) if s['a2'] > 1e-6]
+        af = max(s['a2'] for s in S)
+        H = head(S, af)
+        if H is None: out[tag] = dict(error='no flange head found at the leg end'); continue
+        out[tag] = dict(M=round(af, 4), head=H, r_behind_head=round(r_at(S, H['back'] - 0.01), 4), bore=bore(S, 0.0, af))
+    f, c = out.get('flats', {}), out.get('corners', {})
+    if 'head' in f and 'head' in c:
+        out['M'] = f['M']; out['head'] = f['head']; out['bore'] = f['bore']
+        out['flats_r_behind_head'] = f['r_behind_head']; out['corners_r_behind_head'] = c['r_behind_head']
+        out['head_same_in_both_planes'] = all(abs(f['head'][k] - c['head'][k]) < 2e-4 for k in ('O', 'TH', 'GI', 'GO', 'GD'))
+    return out
+
+
+if __name__ == '__main__':
+    a = sys.argv[1:]
+    for k in range(0, len(a), 3):
+        print(json.dumps(measure_leg(a[k], int(a[k + 1]), int(a[k + 2]))))
diff -ruN a/tools/measure/hoseb_model.py b/tools/measure/hoseb_model.py
--- a/tools/measure/hoseb_model.py	1969-12-31 18:00:00.000000000 -0600
+++ b/tools/measure/hoseb_model.py	2026-10-18 15:38:51.008032100 -0500
@@ -0,0 +1,211 @@
+# 2026-10-09 (wave 2, HOSEB + PERLEGSW; 2026-10-18 genfeat HOSEB: the table's corner puck, see body()): OCP closed loop of the new elbow configurations (4601 / 4603 hose elbows with the face-off, 6807
+# double adjustable-ORB elbow). Rebuilds a configuration from the generator's own build_rows() data IN THE MACRO'S FEATURE ORDER (leg revolves,
+# hex arms, corner puck - nwo_model.body; then the face-off HOSEFACEi cut + STUBFILLi refill from the SW2 face-off values; the locknut hex cuts;
+# the bores; threads not modelled), writes a STEP, reads it back and measures it:
+#   * one solid; locknut cut volume = nwo_nut_removed() (the macro's NutHexCutNWO expectation); face-off cut >= the stub ring, refill = the stub
+#     ring exactly, net change (< 0 where the corner stood past the hose hex face, 0 where it clears);
+#   * nothing of the forged corner past the hose hex face outside the stub (90 deg: up to the other leg's hex arm end; 45 deg: any direction),
+#     up to the bead: volume of the solid in that region = 0;
+#   * hose leg from the STEP faces: coaxial cylinders stub rS / bead rA / bore, planes normal to the hose axis at the hex face, the bead edges
+#     and the tip; NO face left by the face-off (no cylinder at rin, no plane at the face-off end);
+#   * every adjustable-ORB leg from the STEP with the SAME extractor used on the Brennan 6801 STEPs (nwo.measure_nwo / parse, per leg): tip,
+#     I3, thread length, undercut, washer, nut, neck = the generator's values.
+# usage: hoseb_model.py <root> [<pn> ...]   (env as gen_tee: OMI_ROOT, GT_OUT; HB_OUT = folder for the STEPs and results.json)
+import os as _os, sys as _sys
+_HERE = _os.path.dirname(_os.path.abspath(__file__)); _TOOLS = _os.path.dirname(_HERE)
+for _p in (_os.path.join(_TOOLS, 'generators'), _TOOLS, _HERE):
+    if _p not in _sys.path: _sys.path.insert(0, _p)
+import omi_paths as OP
+import sys, os, math, json
+os.environ.setdefault('GT_OUT', OP.SCRATCH)
+from OCP.gp import gp_Pnt, gp_Dir, gp_Ax2
+from OCP.BRepPrimAPI import BRepPrimAPI_MakeBox, BRepPrimAPI_MakeCylinder, BRepPrimAPI_MakeRevol
+from OCP.gp import gp_Ax1
+from OCP.BRepAlgoAPI import BRepAlgoAPI_Common
+from OCP.TopExp import TopExp_Explorer
+from OCP.TopAbs import TopAbs_FACE, TopAbs_SOLID
+from OCP.TopoDS import TopoDS
+from OCP.BRepAdaptor import BRepAdaptor_Surface
+from OCP.GeomAbs import GeomAbs_Cylinder, GeomAbs_Plane
+import nwo_model as NM
+from nwo_model import MM, vol, fuse, cut, hex_prism, write
+from nwo import measure_nwo, parse, walk, key as nkey
+from prof import leg_edges
+from swiv import seg_list
+from prof import shape
+
+
+def cyl(u, a0, a1, r):
+    """solid cylinder of radius r about the leg axis u (through the origin) from a0 to a1"""
+    return BRepPrimAPI_MakeCylinder(gp_Ax2(gp_Pnt(a0 * u[0] * MM, a0 * u[1] * MM, 0), gp_Dir(u[0], u[1], 0)), r * MM, (a1 - a0) * MM).Shape()
+
+
+def ring(u, a0, a1, r0, r1): return cut(cyl(u, a0, a1, r1), cyl(u, a0, a1, r0))
+
+
+def box(x0, y0, z0, x1, y1, z1): return BRepPrimAPI_MakeBox(gp_Pnt(x0 * MM, y0 * MM, z0 * MM), gp_Pnt(x1 * MM, y1 * MM, z1 * MM)).Shape()
+
+
+def nsolids(S):
+    e = TopExp_Explorer(S, TopAbs_SOLID); n = 0
+    while e.More(): n += 1; e.Next()
+    return n
+
+
+def axes(e45): return [(1.0, 0.0), NM.U135 if e45 else (0.0, 1.0)]
+
+
+def body(b, e45):
+    """2026-10-18 (genfeat HOSEB, batch-16 base): nwo_model.body with the corner puck of the TABLE (PUCK_XC / PUCK_R1B / PUCK_HB of the SW2 row:
+    equator AC - PUCK_INSET since the 2026-10-09 puck fix) instead of nwo_model's puck at AC - the macro's puck, so the rebuild is the macro's"""
+    legs = b['legs']; BR = b['BR']; c = b['cols']; S = None
+    for i, lg in enumerate(legs):
+        s = NM.revolve_leg_u(lg['V'], NM.U135) if (e45 and i == 1) else NM.revolve_leg(lg['V'], i); S = s if S is None else fuse(S, s)
+    for i, lg in enumerate(legs):
+        S = fuse(S, NM.hex_prism_u(NM.U135, 2 * BR, 0.0, lg['hexl']) if (e45 and i == 1) else hex_prism(i, 2 * BR, 0.0, lg['hexl']))
+    h = c['PUCK_HB@PUCK']; r1 = c['PUCK_R1B@PUCK']; xc = c['PUCK_XC@PUCK']
+    assert abs(c['PUCK_HT@PUCK'] - h) < 1e-12 and abs(c['PUCK_R1T@PUCK'] - r1) < 1e-12
+    pk = BRepPrimAPI_MakeRevol(NM.face([(0, 0, -h), (r1, 0, -h), (xc, 0, 0), (r1, 0, h), (0, 0, h)]), gp_Ax1(gp_Pnt(0, 0, 0), gp_Dir(0, 0, 1)), 2 * math.pi).Shape()
+    return fuse(S, pk)
+
+
+def build(b, e45):
+    """the macro's order: legs + hex arms + puck -> face-off cut + refill -> locknut cuts -> bores"""
+    legs = b['legs']; c = b['cols']; U = axes(e45); info = {}
+    S = body(b, e45)
+    for i, lg in enumerate(legs, 1):
+        fo = lg.get('faceoff')
+        if not fo: continue
+        u = U[i - 1]; sh = c[f'D1@HFPLN{i}']; dep = c[f'DEPTH@HOSEFACE{i}']; rin = c[f'HF{i}_DIN@HOSEFACE{i}_SK'] / 2; rS = c[f'SF{i}_DOUT@STUBFILL{i}_SK'] / 2
+        if e45: tool = ring(u, sh, sh + dep, rin, c[f'HF{i}_DOUT@HOSEFACE{i}_SK'] / 2)
+        else:
+            assert u == (1.0, 0.0)
+            zh = c[f'HF{i}_ZH@HOSEFACE{i}_SK']
+            tool = cut(box(sh, -c[f'HF{i}_YLO@HOSEFACE{i}_SK'], -zh, sh + dep, c[f'HF{i}_YTOP@HOSEFACE{i}_SK'], zh), cyl(u, sh, sh + dep, rin))
+        v0 = vol(S); S = cut(S, tool); v1 = vol(S); S = fuse(S, ring(u, sh, sh + dep, rin, rS)); v2 = vol(S)
+        info[f'HOSEFACE{i}'] = dict(cut=v0 - v1, fill=v2 - v1, ring=math.pi * (rS ** 2 - rin ** 2) * dep, net=v2 - v0, past=fo['past'])
+    for i, lg in enumerate(legs):
+        if lg['kind'] != 'NWO': continue
+        assert not (e45 and i == 1)
+        n = lg['nut']; BIG = 20.0
+        slab = box(-BIG, n['n0'], -BIG, BIG, n['w0'], BIG) if i == 1 else box(n['n0'], -BIG, -BIG, n['w0'], BIG, BIG)
+        v0 = vol(S); S = cut(S, cut(slab, hex_prism(i, n['af'], n['n0'], n['w0']))); info[f'NUTCUT{i + 1}'] = dict(removed=v0 - vol(S), expect=NM_T.nwo_nut_removed(n))
+    for i, lg in enumerate(legs):
+        S = cut(S, cyl(U[i], 0.0, lg.get('Mtip', lg['V'][-1][0]), lg['bore'] / 2))
+    return S, info
+
+
+def residual(S, b, e45):
+    """volume of the finished solid past each hose hex face, outside the stub, before the bead (must be 0)"""
+    out = {}
+    for i, lg in enumerate(b['legs'], 1):
+        if lg['kind'] != 'HOSEB': continue
+        u = axes(e45)[i - 1]; sh = lg['hexl']; b0 = lg['bead'][0]; rS = lg['rS']
+        if e45: R = cut(cyl(u, sh + 1e-4, b0 - 1e-4, 10.0), cyl(u, sh, b0, rS + 1e-5))
+        else: R = cut(box(sh + 1e-4, -10, -10, b0 - 1e-4, b['cols'][f'HF{i}_YTOP@HOSEFACE{i}_SK'] - 1e-4, 10), cyl(u, sh, b0, rS + 1e-5))
+        out[f'leg{i}'] = vol(BRepAlgoAPI_Common(S, R).Shape())
+    return out
+
+
+def faces(p, u):
+    """cylinders coaxial with the leg axis u (radius, axial span) and planes normal to it (position) of a STEP"""
+    S = shape(p); e = TopExp_Explorer(S, TopAbs_FACE); cy, pl = set(), set()
+    while e.More():
+        f = TopoDS.Face(e.Current()) if hasattr(TopoDS, "Face") else TopoDS.Face_s(e.Current()); s = BRepAdaptor_Surface(f); e.Next()
+        if s.GetType() == GeomAbs_Cylinder:
+            c = s.Cylinder(); d = c.Axis().Direction(); L = c.Location()
+            if abs(abs(d.X() * u[0] + d.Y() * u[1]) - 1) > 1e-6: continue
+            lx, ly, lz = L.X() / MM, L.Y() / MM, L.Z() / MM; t = lx * u[0] + ly * u[1]
+            if math.hypot(lx - t * u[0], ly - t * u[1], lz) > 1e-5: continue
+            cy.add(round(c.Radius() / MM, 5))
+        elif s.GetType() == GeomAbs_Plane:
+            q = s.Plane(); d = q.Axis().Direction(); L = q.Location()
+            if abs(abs(d.X() * u[0] + d.Y() * u[1]) - 1) > 1e-6: continue
+            pl.add(round((L.X() * u[0] + L.Y() * u[1]) / MM, 5))
+    return cy, pl
+
+
+def measure_legs(p, legs):
+    """nwo.measure_nwo on GIVEN legs [(axis, sign)] (its own legs_of() takes the two largest box extents - on a 45 deg hose elbow those can
+    both belong to the angled hose leg); same section walk and parse"""
+    res = []
+    for axis, sign in legs:
+        for pn in [k for k in (0, 1, 2) if k != axis]:
+            S = [s for s in seg_list(leg_edges(p, axis, sign, pn, a0=0.05)) if min(s['r1'], s['r2']) > -1e-6]
+            at = max(max(s['a1'], s['a2']) for s in S)
+            face = [s for s in S if abs(s['a1'] - at) < 1e-3 and abs(s['a2'] - at) < 1e-3]
+            if not face: continue
+            rstart = max(max(s['r1'], s['r2']) for s in face)
+            res.append(((axis, sign, pn), at, walk(S, nkey((at, rstart)), 0.06)))
+    return res
+
+
+def nwo_legs(p, legs=None):
+    """the adjustable ORB legs of a STEP, per leg (axis, sign), with nwo.py's own pattern (the Brennan 6801 extractor)"""
+    best = {}
+    for leg, at, pts in (measure_legs(p, legs) if legs else measure_nwo(p)):
+        M = parse(at, pts)
+        if len(M) < 6: continue
+        t, u_, w, n, k, b = M[:6]
+        if not (u_[2] < t[2] and w[2] > u_[2] and n[2] < w[2] + 0.2 and k[2] < n[2] and b[2] > k[2] - 0.05): continue
+        c = dict(tip=round(at, 4), TM=round(2 * t[2], 4), UR=round(u_[2], 4), THDL=round(at - u_[0], 4), WR=round(w[2], 4), WT=round(w[0] - w[1], 4),
+                 NUTR=round(n[2], 4), NUTT=round(n[0] - n[1], 4), NECKR=round(k[2], 4), NECKL=round(k[0] - k[1], 4), I3=round(at - k[1], 4))
+        key = leg[:2]
+        if key not in best or c['NUTR'] < best[key]['NUTR']: best[key] = c
+    return best
+
+
+def run(T, root, pns=(), outd=None, verbose=True):
+    """closed loop of every buildable configuration of a gen_tee root (or the listed ones); T = the imported gen_tee (SPEC may carry injected
+    TEST roots). Returns (results, problems)."""
+    global NM_T
+    NM_T = T; e45 = bool(T.SPEC[root].get('e45')); outd = outd or os.environ.get('HB_OUT', OP.SCRATCH); os.makedirs(outd, exist_ok=True)
+    built, _ = T.build_rows(root); res = {}; bad = []
+    for b in built:
+        if b['chk'] or (pns and b['pn'] not in pns): continue
+        S, info = build(b, e45); path = os.path.join(outd, f'MODEL_{b["pn"]}.stp'); write(S, path)
+        r = dict(volume=vol(S), solids=nsolids(S), info=info, residual=residual(S, b, e45)); errs = []
+        if r['solids'] != 1: errs.append(f'{r["solids"]} solids')
+        for k, v in info.items():
+            if k.startswith('NUTCUT') and abs(v['removed'] - v['expect']) > 0.005 * v['expect']: errs.append(f'{k} removed {v["removed"]:.6f} vs {v["expect"]:.6f}')
+            if k.startswith('HOSEFACE'):
+                if v['cut'] < 0.98 * v['ring']: errs.append(f'{k} cut {v["cut"]:.6f} < ring')
+                if abs(v['fill'] - v['ring']) > 1e-4 * v['ring']: errs.append(f'{k} refill {v["fill"]:.7f} vs ring {v["ring"]:.7f}')
+                if (v['net'] < -1e-3 * v['ring']) != v['past']: errs.append(f'{k} net {v["net"]:.6f} vs past {v["past"]}')
+        for k, v in r['residual'].items():
+            if v > 1e-7: errs.append(f'{k}: {v:.7f} in^3 of the solid past the hose hex face outside the stub')
+        # hose leg faces from the STEP
+        for i, lg in enumerate(b['legs'], 1):
+            if lg['kind'] != 'HOSEB': continue
+            u = axes(e45)[i - 1]; cy, pl = faces(path, u); fo = lg['faceoff']; L_ = lg['V'][-1][0]; b0, b1 = lg['bead']
+            want_c = {round(lg['rS'], 5), round(lg['rA'], 5), round(lg['bore'] / 2, 5)}; want_p = {round(x, 5) for x in (lg['hexl'], b0, b1, L_)}
+            r[f'hose{i}'] = dict(cylinders=sorted(cy), planes=sorted(pl))
+            if not want_c <= cy: errs.append(f'hose leg {i}: cylinders {sorted(cy)} miss {sorted(want_c - cy)}')
+            if not want_p <= pl: errs.append(f'hose leg {i}: planes {sorted(pl)} miss {sorted(want_p - pl)}')
+            if round(fo['rin'], 5) in cy: errs.append(f'hose leg {i}: a face-off cylinder (rin {fo["rin"]}) is left')
+            if round(lg['hexl'] + fo['depth'], 5) in pl: errs.append(f'hose leg {i}: a face-off end plane ({lg["hexl"] + fo["depth"]:.4f}) is left')
+        # adjustable ORB legs from the STEP (nwo.py extractor) vs the generator's leg values
+        got = nwo_legs(path, [(0, 1)] + ([] if e45 else [(1, 1)])); r['nwo'] = {str(k): v for k, v in got.items()}
+        for i, lg in enumerate(b['legs']):
+            if lg['kind'] != 'NWO': continue
+            key = (0, 1) if i == 0 else ((1, 1) if not e45 else None)
+            m = got.get(key)
+            want = dict(tip=lg['V'][-1][0], I3=lg['endlen'], THDL=round(lg['V'][-1][0] - lg['te'], 4), UR=lg['UR'], WR=lg['m']['WR'], WT=lg['m']['WT'],
+                        NUTR=lg['nut']['af'] / 2, NUTT=lg['m']['NUTT'], NECKR=lg['m']['NECKR'], NECKL=lg['m']['NECKL'], TM=2 * lg['rM'])
+            if not m: errs.append(f'leg {i + 1}: the nwo.py extractor found no adjustable ORB leg on {key}'); continue
+            dif = {k: (m[k], round(v, 4)) for k, v in want.items() if abs(m[k] - v) > 0.0015}
+            r[f'nwo_leg{i + 1}'] = dict(measured=m, want={k: round(v, 4) for k, v in want.items()}, diff=dif)
+            if dif: errs.append(f'leg {i + 1} NWO measured != generator: {dif}')
+        r['errors'] = errs; res[b['pn']] = r; bad += [f'{b["pn"]}: {x}' for x in errs]
+        if verbose: print(b['pn'], 'volume %.5f in^3, %d solid(s)' % (r['volume'], r['solids']),
+              {k: {kk: round(vv, 6) if isinstance(vv, float) else vv for kk, vv in v.items()} for k, v in info.items()},
+              'residual', {k: round(v, 8) for k, v in r['residual'].items()}, 'OK' if not errs else errs)
+    json.dump(res, open(os.path.join(outd, f'results_{root}.json'), 'w'), indent=1, default=str)
+    return res, bad
+
+
+if __name__ == '__main__':
+    import gen_tee
+    root = sys.argv[1]
+    res, bad = run(gen_tee, root, sys.argv[2:])
+    print(root, 'closed loop', 'PASS' if not bad else f'FAIL ({len(bad)})')
