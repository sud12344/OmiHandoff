+    swSkMgr.AddToDB = False
+    lc.ConstructionGeometry = True
+    Dim n1 As SldWorks.SketchLine, n1b As SldWorks.SketchLine, n2 As SldWorks.SketchLine, n3 As SldWorks.SketchLine, nc As SldWorks.SketchLine
