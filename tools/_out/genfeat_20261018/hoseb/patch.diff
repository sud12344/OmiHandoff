+    Else
+        Check "HOSEFACE" & i & " + STUBFILL" & i & " leave the reference configuration unchanged (the corner clears the face): net " & Format((v2 - v0) / (IN_ ^ 3), "0.000000") & " in^3", Abs(v2 - v0) < 0.001 * ring
+    End If
+End Sub
